PORT=3100
NODE_ENV=development
WECHAT_APP_ID=
WECHAT_APP_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_APP_TOKEN=
FEISHU_BASE_TABLE_ID=
# STORE_DB_PATH may override the default server/data/store.sqlite.
# Set NODE_ENV=production and real WeChat credentials before deployment.
# Keep secrets only on the server, never in the mini program.

# External dialogue service: leave disabled until the deployed URL is verified.
# Secrets are server-only. No default URL or key is supplied.
ASSISTANT_CHAT_ENABLED=false
ASSISTANT_CHAT_URL=
ASSISTANT_CHAT_API_KEY=
ASSISTANT_CHAT_TIMEOUT_MS=20000
ASSISTANT_CHAT_MAX_CONCURRENT=8

# Shelf-photo stocktake: OpenAI-compatible image understanding API, server only.
# Disabled until a genuine image model endpoint and credentials are provided.
STOCKTAKE_VISION_ENABLED=false
STOCKTAKE_VISION_URL=
STOCKTAKE_VISION_API_KEY=
STOCKTAKE_VISION_MODEL=

# 个人助理：手机坐标转换成街道，仅服务器保存高德 Web 服务 key
# AMAP_WEB_SERVICE_KEY=
# COMPANION_LOCATION_ENABLED=true

# Server-only signing secret for independent family accounts (32+ random characters).
# COMPANION_FAMILY_SECRET=
